Options -Indexes

# Clean PHP routes under the documented /ojtrack/ install path. Direct .php
# requests redirect without changing the request method or query string; the
# extensionless route is then internally mapped to its existing PHP file.
RewriteEngine On
RewriteBase /ojtrack/
# Internal source, setup files, and repository metadata are never HTTP endpoints.
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:config|database|bin|tests|docs|scratch|ui-review)(?:/|$) - [F,L,NC]
RewriteCond %{THE_REQUEST} \s/+ojtrack/(.+?)\.php(?:[?\s]) [NC]
RewriteRule ^(.+?)\.php$ $1 [R=308,L,NE]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [END]

<FilesMatch "\.(sql|md|log)$">
    Require all denied
</FilesMatch>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
